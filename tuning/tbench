#!/usr/bin/env bash
# Terminal-Bench-Local (Core-19): 19 real terminal tasks, graded pass/fail.
# Each task gets up to 2 attempts (pass@2). Results are logged to MLflow.
#
#   ./tbench setup                    # once: download the benchmark (pinned version)
#   ./tbench doctor                   # checks Docker, the endpoint and the tasks; no inference
#   ./tbench smoke "first try"        # 1 task, about 10-30 minutes
#   ./tbench full "coder MTP2"        # all 19 tasks, about 10 hours: run it inside tmux
#   ./tbench log "note"               # log the newest finished result to MLflow (done
#                                     #   automatically after smoke/full)
#
# Model: MODEL=coder-tb by default (QUANT and PROFILE describe it in the results):
#   MODEL=coder-2 ./tbench smoke "card 2"
#   TARGET=marvin ./tbench smoke "flash-next"     (marvin's model, labelled as marvin)
#   TARGET=marvin-strata ./tbench full "strata"   (Strata on marvin; start it first: marvin's strata-test.sh start)
#
# With a skill (instruction file added to the agent's prompt; frontmatter stripped):
#   SKILL=instructions/the-craft@3c329d0.md ./tbench smoke "the-craft"
#   (the profile name gets "+<skill>" appended, so these runs never mix with plain ones)
set -e
cd "$(dirname "$0")"
REPO=https://github.com/kyuz0/terminal-bench-mini.git
PIN=60739af                         # Terminal-Bench-Local commit, 2026-10-27
DIR=terminal-bench
# TARGET=marvin: marvin's big model through zaphod (marvin/big), labelled as marvin in the results.
if [ "${TARGET:-zaphod}" = marvin ]; then
  MODEL="${MODEL:-marvin/big}"; MODEL_NAME="${MODEL_NAME:-Qwen3.8-Flash-Next}"; QUANT="${QUANT:-UD-IQ4_XS}"
  PROFILE="${PROFILE:-mtp3-128k-np2}"; PLATFORM=strixhalo; PLATFORM_NAME="marvin, Radeon 8060S (Strix Halo)"
  CONTEXT_LENGTH="${CONTEXT_LENGTH:-131072}"   # peer models don't advertise it through zaphod
fi
# TARGET=marvin-strata: Strata on marvin (plans/strix-strata.md), started with marvin's ~/strata-test/strata-test.sh start
if [ "${TARGET:-zaphod}" = marvin-strata ]; then
  MODEL="${MODEL:-qwen3.8-flash-next-unsloth-ud-iq4_xs}"; MODEL_NAME="${MODEL_NAME:-Qwen3.8-Flash-Next}"; QUANT="${QUANT:-UD-IQ4_XS}"
  PROFILE="${PROFILE:-strata0.2.7-mtp-128k-np2}"; PLATFORM=strixhalo; PLATFORM_NAME="marvin, Radeon 8060S (Strix Halo)"
  CONTEXT_LENGTH="${CONTEXT_LENGTH:-131072}"; ENDPOINT=http://marvin:8099/v1; ENGINE=strata; BACKEND=hip; BACKEND_VERSION=rocm-gfx1151
  export MACHINE=marvin
fi
ENDPOINT="${ENDPOINT:-http://127.0.0.1:8080/v1}"; ENGINE="${ENGINE:-llama.cpp}"; BACKEND="${BACKEND:-vulkan}"
BACKEND_VERSION="${BACKEND_VERSION:-mesa-26.0}"
CTX=(); [ -n "$CONTEXT_LENGTH" ] && CTX=(--context-length "$CONTEXT_LENGTH")
PLATFORM="${PLATFORM:-r9700}"; PLATFORM_NAME="${PLATFORM_NAME:-zaphod, Radeon AI PRO R9700}"
MODEL="${MODEL:-coder-tb}"       # card 1, 256K context, q8_0 context memory, MTP
MODEL_NAME="${MODEL_NAME:-Qwen3.8-27B}"
QUANT="${QUANT:-UD-Q4_K_XL}"
PROFILE="${PROFILE:-mtp2-256k-kvq8}"   # describe the setup: e.g. mtp3-256k-kvq8

usage() { sed -n '2,17p' "$0"; exit 1; }
need_repo() { [ -d "$DIR" ] || { echo "Run ./tbench setup first."; exit 1; }; }
if [ -n "$SKILL" ]; then
  [ -f "$SKILL" ] || { echo "SKILL file not found: $SKILL"; exit 1; }
  grep -q 'local-ai-lab: extra instructions' "$DIR/compat/harbor_prompt/sitecustomize.py" 2>/dev/null \
    || { echo "Skill support not installed. Run: ./tbench setup"; exit 1; }
  export TBENCH_EXTRA_INSTRUCTIONS="$(realpath "$SKILL")"
  export SKILL_NAME=$(basename "$SKILL" .md) SKILL_SHA=$(sha256sum "$SKILL" | cut -c1-12)
  PROFILE="$PROFILE+$SKILL_NAME"
  echo "== with instructions: $SKILL_NAME ($SKILL_SHA); profile $PROFILE"
else
  unset TBENCH_EXTRA_INSTRUCTIONS
fi
key() {
  if [ "$ENGINE" = strata ]; then export TBENCH_API_KEY="$(ssh marvin cat strata-test/key)"   # made per Strata start
  else set -a; . ~/llama-swap/.env; set +a; export TBENCH_API_KEY="$ZAPHOD_KEY"; fi
}

log_latest() {
  local note="$1" f
  f=$(find "$DIR/results/suites" -path "*$PLATFORM*" -name summary.json -printf '%T@ %p\n' 2>/dev/null \
      | sort -n | tail -1 | cut -d' ' -f2-)
  [ -n "$f" ] || { echo "No finished $PLATFORM result found yet."; exit 1; }
  echo "== logging $f"
  ./log "${MACHINE:-zaphod}" "$MODEL" "$note" "$f"
}

run_tier() {
  local tier="$1" note="$2"
  need_repo; key
  export RUN_START=$(date +%s)   # ./log reads real-use speed for this window from llama-swap's request log
  (cd "$DIR" && ./terminal_bench.py run --suite core19 --tier "$tier" \
     --endpoint "$ENDPOINT" --model "$MODEL" "${CTX[@]}" \
     --platform "$PLATFORM" --platform-name "$PLATFORM_NAME" \
     --model-name "$MODEL_NAME" --engine "$ENGINE" --backend "$BACKEND" --backend-version "$BACKEND_VERSION" \
     --quant "$QUANT" --inference-profile "$PROFILE")
  log_latest "$note"
}

case "$1" in
setup)
  [ -d "$DIR" ] || git clone -q "$REPO" "$DIR"
  (cd "$DIR" && git fetch -q && git checkout -q "$PIN" && git log -1 --format='Terminal-Bench-Local pinned at %h (%cd)')
  python3 tbench-skill-patch.py "$DIR"
  ;;
doctor) need_repo; key
  (cd "$DIR" && ./terminal_bench.py doctor --suite core19 --tier smoke \
     --endpoint "$ENDPOINT" --model "$MODEL" "${CTX[@]}") ;;
smoke) [ -n "$2" ] || usage; run_tier smoke "$2" ;;
full)  [ -n "$2" ] || usage
  [ -n "$TMUX" ] || { echo "A full run takes about 10 hours. Start it inside tmux:"
                      echo "  tmux new -s tbench"; echo "  cd ~/homelab/tuning && ./tbench full \"$2\""
                      echo "Detach with Ctrl-b then d; reattach with: tmux attach -t tbench"; exit 1; }
  run_tier full "$2" ;;
log)   [ -n "$2" ] || usage; log_latest "$2" ;;
*) usage ;;
esac
