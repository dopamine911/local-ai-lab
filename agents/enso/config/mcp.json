{
  "mcpServers": {
    "lab": {
      "url": "http://mcpjungle:8080/mcp",
      "headers": {
        "Authorization": "!printf 'Bearer %s' \"$(cat /home/ubuntu/.enso/keys/mcp-token)\""
      },
      "description": "The lab's tools through MCPJungle: web search and page reading, a headless browser, and memory (search the lab's own notes)",
      "exposure": "deferred",
      "toolExposure": {
        "search__*": "direct",
        "browser__*": "deferred",
        "memory__*": "direct"
      }
    }
  }
}
