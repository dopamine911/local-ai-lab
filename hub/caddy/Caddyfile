{
	# Listen only on zaphod's Tailscale address: unreachable from the home network or internet.
	default_bind {$TS_IP}
}

{$DOMAIN}, *.{$DOMAIN} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	@zaphod  host zaphod.{$DOMAIN}
	@marvin  host marvin.{$DOMAIN}
	@chat    host chat.{$DOMAIN}
	@monitor host monitor.{$DOMAIN}
	@models  host models.{$DOMAIN}
	@mlflow  host mlflow.{$DOMAIN}
	@comfy   host comfy.{$DOMAIN}
	@notify  host notify.{$DOMAIN}
	@act     host act.{$DOMAIN}

	# llama-swap UIs (each still asks for its own API key)
	handle @zaphod {
		reverse_proxy 127.0.0.1:8080
	}
	handle @marvin {
		reverse_proxy marvin:8080
	}

	handle @chat {
		reverse_proxy 127.0.0.1:3000
	}
	handle @mlflow {
		reverse_proxy 127.0.0.1:5000
	}
	# ComfyUI has no login: anyone on your tailnet can use it while image mode is on.
	handle @comfy {
		reverse_proxy 127.0.0.1:8188
	}
	handle @monitor {
		reverse_proxy 127.0.0.1:8090
	}
	# Notifications (ntfy): the phone app logs in as `daniel`; scripts send with a token. Access rules in compose.yaml.
	handle @notify {
		reverse_proxy 127.0.0.1:2586
	}
	# Notification buttons (hub/actions/actiond.py): each request needs a signed one-time token from a notification.
	handle @act {
		reverse_proxy 127.0.0.1:2587
	}

	# Models panel (hub/models-panel, #64): Caddy adds the API keys, so the browser never sees them. Only the calls the
	# page makes pass (status reads, load = an upstream /health request, unload); chat and the rest get 404 here.
	# Anyone on your tailnet who opens it can load/unload models.
	handle @models {
		@z_read {
			method GET
			path /zaphod/running /zaphod/v1/models /zaphod/api/performance /zaphod/api/profiles /zaphod/upstream/*/health /zaphod/upstream/*/slots
		}
		@z_unload {
			method POST
			path /zaphod/api/models/unload/*
		}
		@m_read {
			method GET
			path /marvin/running /marvin/v1/models /marvin/api/performance /marvin/api/profiles /marvin/upstream/*/health /marvin/upstream/*/slots
		}
		@m_unload {
			method POST
			path /marvin/api/models/unload/*
		}
		@mlsearch {
			method POST
			path /mlflow/runs/search
		}
		@api path /zaphod/* /marvin/* /mlflow/* /config/*
		handle @z_read {
			uri strip_prefix /zaphod
			reverse_proxy 127.0.0.1:8080 {
				header_up Authorization "Bearer {env.ZAPHOD_KEY}"
			}
		}
		handle @z_unload {
			uri strip_prefix /zaphod
			reverse_proxy 127.0.0.1:8080 {
				header_up Authorization "Bearer {env.ZAPHOD_KEY}"
			}
		}
		handle @m_read {
			uri strip_prefix /marvin
			reverse_proxy marvin:8080 {
				header_up Authorization "Bearer {env.MARVIN_KEY}"
			}
		}
		handle @m_unload {
			uri strip_prefix /marvin
			reverse_proxy marvin:8080 {
				header_up Authorization "Bearer {env.MARVIN_KEY}"
			}
		}
		# Last speed per model: MLflow's run search only (read-only; MLflow is open on the tailnet anyway)
		handle @mlsearch {
			rewrite * /api/2.0/mlflow/runs/search
			reverse_proxy 127.0.0.1:5000 {
				header_up Host 127.0.0.1:5000
				header_up -Origin   # MLflow refuses other sites' Origin (403); the call is Caddy's, on zaphod
			}
		}
		# Each machine's llama-swap config, read-only, for the model details (in the public repo; ${env.X} references only)
		handle /config/zaphod.yaml {
			rewrite * /zaphod/config.yaml
			root * /srv/lab-config
			file_server
		}
		handle /config/marvin.yaml {
			rewrite * /marvin/config.yaml
			root * /srv/lab-config
			file_server
		}
		handle @api {
			respond "not a models-panel call" 404
		}
		handle {
			root * /srv/models-panel
			file_server
		}
	}

	# Everything else: the Homepage start page
	handle {
		reverse_proxy 127.0.0.1:3001
	}
}
