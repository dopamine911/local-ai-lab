# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env && nano .env

# Your domain, without "https://". Subdomains: chat., monitor., zaphod., marvin., models.
DOMAIN=ai.example.com

# zaphod's Tailscale address. Get it with:  tailscale ip -4
TS_IP=100.117.73.97

# Cloudflare API token: Zone -> DNS -> Edit, limited to your domain.
CF_API_TOKEN=CHANGE_ME

# Same key as ~/llama-swap/.env. Fill with:  grep ZAPHOD_KEY ~/llama-swap/.env >> .env
# (then delete this placeholder line)
ZAPHOD_KEY=CHANGE_ME

# marvin's llama-swap key (set tonight when marvin is built)
MARVIN_KEY=CHANGE_ME

# Beszel agent key: from the Beszel page, "Add system" (README step 7)
BESZEL_KEY=
OPEN_TERMINAL_API_KEY=CHANGE_ME
SEARXNG_SECRET=CHANGE_ME
WEBUI_SECRET_KEY=CHANGE_ME
